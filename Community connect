<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CommunityConnect Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style type="text/tailwindcss">
        @layer base {
            body {
                font-family: 'Inter', sans-serif;
            }
        }
        @layer components {
            .tab-button {
                @apply flex items-center p-2 text-gray-700 rounded-lg dark:text-white hover:bg-emerald-100 dark:hover:bg-emerald-700 group;
            }
            .tab-button.active {
                @apply bg-emerald-200 dark:bg-emerald-600 font-semibold;
            }
            .card {
                @apply bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden;
            }
            .marketplace-card-image {
                @apply w-full h-48 object-cover;
            }
            .match-card {
                @apply bg-white dark:bg-gray-800 rounded-lg shadow-md p-4 mb-4;
            }
            .form-input {
                @apply block w-full p-2 border border-gray-300 rounded-md shadow-sm focus:ring-emerald-500 focus:border-emerald-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white;
            }
            .form-select {
                @apply block w-full p-2 border border-gray-300 rounded-md shadow-sm focus:ring-emerald-500 focus:border-emerald-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white;
            }
            .primary-button {
                @apply px-4 py-2 bg-emerald-600 text-white font-medium rounded-md hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500;
            }
            .secondary-button {
                @apply px-4 py-2 bg-gray-200 text-gray-800 font-medium rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600;
            }
        }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white">
    <div id="app" class="flex flex-col md:flex-row min-h-screen">
        <!-- Sidebar Navigation -->
        <aside class="w-full md:w-64 bg-white dark:bg-gray-800 shadow-lg md:shadow-none p-4 md:p-6 flex-shrink-0">
            <div class="flex items-center justify-between mb-8">
                <h1 class="text-2xl font-bold text-emerald-600">CommunityConnect</h1>
                <!-- Optional: Mobile menu toggle if needed -->
            </div>
            <nav>
                <ul class="space-y-2">
                    <li>
                        <button id="tab-marketplace" class="tab-button active w-full justify-start">
                            <svg class="w-5 h-5 text-gray-500 transition duration-75 dark:text-gray-400 group-hover:text-emerald-900 dark:group-hover:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 0a10 10 0 1 0 10 10A10.01 10.01 0 0 0 10 0Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Zm-2.732-5.5a1 1 0 0 0 1 1h.732A3.2 3.2 0 0 0 13 11.2V9.333a.666.666 0 0 0-.666-.666H8.5V7a1 1 0 0 0-2 0v1.667H6.666A.667.667 0 0 0 6 9.333V11.2A3.2 3.2 0 0 0 8.268 13.5Zm3.942-7.5a1 1 0 1 0-2 0v1.667h2V6Z"/>
                            </svg>
                            <span class="ms-3">Local Marketplace</span>
                        </button>
                    </li>
                    <li>
                        <button id="tab-skillswap" class="tab-button w-full justify-start">
                            <svg class="w-5 h-5 text-gray-500 transition duration-75 dark:text-gray-400 group-hover:text-emerald-900 dark:group-hover:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 18 20">
                                <path d="M17 5.923A1 1 0 0 0 16 5h-3V4a4 4 0 1 0-8 0v1H2a1 1 0 0 0-1 .923L.086 17.846A2 2 0 0 0 2.08 20h13.84a2 2 0 0 0 1.994-2.153L17 5.923ZM7 4a2 2 0 1 1 4 0v1H7V4Zm0 5a1 1 0 1 0 0 2h4a1 1 0 1 0 0-2H7Z"/>
                            </svg>
                            <span class="ms-3">Skill Swapping Hub</span>
                        </button>
                    </li>
                    <li>
                        <button id="tab-profile" class="tab-button w-full justify-start">
                            <svg class="w-5 h-5 text-gray-500 transition duration-75 dark:text-gray-400 group-hover:text-emerald-900 dark:group-hover:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 0a10 10 0 1 0 10 10A10.01 10.01 0 0 0 10 0Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Zm0-10a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 2a6 6 0 0 0-6 6h12a6 6 0 0 0-6-6Z"/>
                            </svg>
                            <span class="ms-3">My Profile/Availability</span>
                        </button>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 p-4 md:p-8 overflow-y-auto">
            <!-- Local Marketplace Section -->
            <section id="marketplace-section" class="content-section">
                <h2 class="text-3xl font-bold text-gray-800 dark:text-white mb-6">Local Marketplace</h2>
                <div class="flex flex-col md:flex-row gap-4 mb-6">
                    <input type="text" id="marketplace-search" placeholder="Search products..." class="form-input flex-1">
                    <select id="marketplace-category-filter" class="form-select">
                        <option value="All">All Categories</option>
                        <option value="Service">Service</option>
                        <option value="Book">Book</option>
                        <option value="Equipment">Equipment</option>
                        <option value="Local Shop">Local Shop</option>
                    </select>
                </div>
                <div id="marketplace-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    <!-- Product cards will be injected here by JavaScript -->
                </div>
            </section>

            <!-- Skill Swapping Hub Section -->
            <section id="skillswap-section" class="content-section hidden">
                <h2 class="text-3xl font-bold text-gray-800 dark:text-white mb-6">Skill Swapping Hub</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-indigo-50 dark:bg-indigo-900 p-6 rounded-lg shadow-md">
                        <h3 class="text-xl font-semibold text-indigo-700 dark:text-indigo-200 mb-4">Your Skill Exchange</h3>
                        <p class="text-gray-700 dark:text-gray-300 mb-2"><strong>You Offer:</strong> <span id="current-user-offered-skills"></span></p>
                        <p class="text-gray-700 dark:text-gray-300"><strong>You Want:</strong> <span id="current-user-wanted-skills"></span></p>
                    </div>
                    <div class="bg-amber-50 dark:bg-amber-900 p-6 rounded-lg shadow-md">
                        <h3 class="text-xl font-semibold text-amber-700 dark:text-amber-200 mb-4">Available Matches</h3>
                        <div id="skill-matches">
                            <!-- Matched members will be injected here by JavaScript -->
                        </div>
                    </div>
                </div>
            </section>

            <!-- My Profile/Availability Section -->
            <section id="profile-section" class="content-section hidden">
                <h2 class="text-3xl font-bold text-gray-800 dark:text-white mb-6">My Profile & Availability</h2>
                <form id="profile-form" class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md max-w-lg mx-auto">
                    <div class="mb-4">
                        <label for="profile-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
                        <input type="text" id="profile-name" class="form-input" disabled>
                    </div>
                    <div class="mb-4">
                        <label for="profile-offered-skills" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Skills You Offer (comma-separated)</label>
                        <input type="text" id="profile-offered-skills" class="form-input" placeholder="e.g., Math Tutoring, Web Design">
                    </div>
                    <div class="mb-4">
                        <label for="profile-wanted-skills" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Skills You Want (comma-separated)</label>
                        <input type="text" id="profile-wanted-skills" class="form-input" placeholder="e.g., Photography, Spanish Lessons">
                    </div>
                    <div class="mb-6">
                        <label for="profile-availability" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Availability Status</label>
                        <select id="profile-availability" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Available This Weekend">Available This Weekend</option>
                            <option value="Evenings Only">Evenings Only</option>
                            <option value="Weekdays Afternoons">Weekdays Afternoons</option>
                            <option value="Busy">Busy</option>
                            <option value="Flexible">Flexible</option>
                        </select>
                    </div>
                    <button type="submit" class="primary-button">Update Profile</button>
                </form>
            </section>
        </main>
    </div>

    <script>
        // Mock Data
        const products = [
            { id: 1, name: "Intro to Python Textbook", category: "Book", price: "€25", location: "Campus Bookstore", imageUrl: "https://via.placeholder.com/150/f0f9ff/0f172a?text=Python+Book" },
            { id: 2, name: "Scientific Calculator", category: "Equipment", price: "€10", location: "Student Union Shop", imageUrl: "https://via.placeholder.com/150/f0f9ff/0f172a?text=Calculator" },
            { id: 3, name: "Mountain Bicycle", category: "Equipment", price: "To Rent", location: "John's Bike Repair", imageUrl: "https://via.placeholder.com/150/f0f9ff/0f172a?text=Bicycle" },
            { id: 4, name: "Tutoring: Math", category: "Service", price: "€15/hr", location: "Online/Library", imageUrl: "https://via.placeholder.com/150/f0f9ff/0f172a?text=Math+Tutor" },
            { id: 5, name: "Acoustic Guitar", category: "Equipment", price: "€50", location: "Music Dept.", imageUrl: "https://via.placeholder.com/150/f0f9ff/0f172a?text=Guitar" },
            { id: 6, name: "Gardening Tools Set", category: "Equipment", price: "€30", location: "Community Garden Shed", imageUrl: "https://via.placeholder.com/150/f0f9ff/0f172a?text=Gardening+Tools" },
            { id: 7, name: "Spanish Conversation Lessons", category: "Service", price: "Free (Skill Swap)", location: "Language Exchange Group", imageUrl: "https://via.placeholder.com/150/f0f9ff/0f172a?text=Spanish+Lessons" },
            { id: 8, name: "Used Drawing Tablet", category: "Equipment", price: "€75", location: "Art Department", imageUrl: "https://via.placeholder.com/150/f0f9ff/0f172a?text=Drawing+Tablet" },
            { id: 9, name: "Web Development Consultation", category: "Service", price: "Negotiable", location: "Online", imageUrl: "https://via.placeholder.com/150/f0f9ff/0f172a?text=Web+Dev" },
        ];

        const communityMembers = [
            { id: 1, name: "Alice", offeredSkills: ["Math Tutoring", "Web Design"], wantedSkills: ["Photography", "Spanish Lessons"], availability: "Available This Weekend" },
            { id: 2, name: "Bob", offeredSkills: ["Photography", "Cooking"], wantedSkills: ["Math Tutoring", "Guitar Lessons"], availability: "Evenings Only" },
            { id: 3, name: "Charlie", offeredSkills: ["Spanish Lessons", "Guitar Lessons"], wantedSkills: ["Web Design", "Cooking"], availability: "Weekdays Afternoons" },
            { id: 4, name: "Diana", offeredSkills: ["Web Design", "Gardening"], wantedSkills: ["Photography", "Spanish Lessons"], availability: "Flexible" },
            { id: 5, name: "Eve", offeredSkills: ["Photography", "Journalism"], wantedSkills: ["Cooking", "Math Tutoring"], availability: "Mornings Only" },
        ];

        let currentUser = {
            name: "You",
            offeredSkills: ["Cooking", "Gardening"],
            wantedSkills: ["Web Design", "Photography"],
            availability: "Active"
        };

        // DOM Elements
        const marketplaceGrid = document.getElementById('marketplace-grid');
        const marketplaceSearch = document.getElementById('marketplace-search');
        const marketplaceCategoryFilter = document.getElementById('marketplace-category-filter');
        const skillMatchesContainer = document.getElementById('skill-matches');
        const currentUserOfferedSkills = document.getElementById('current-user-offered-skills');
        const currentUserWantedSkills = document.getElementById('current-user-wanted-skills');
        const profileForm = document.getElementById('profile-form');
        const profileNameInput = document.getElementById('profile-name');
        const profileOfferedSkillsInput = document.getElementById('profile-offered-skills');
        const profileWantedSkillsInput = document.getElementById('profile-wanted-skills');
        const profileAvailabilitySelect = document.getElementById('profile-availability');

        const tabButtons = document.querySelectorAll('.tab-button');
        const contentSections = document.querySelectorAll('.content-section');

        // Functions

        // Renders product cards in the marketplace
        function renderMarketplace(productsToRender) {
            marketplaceGrid.innerHTML = ''; // Clear previous cards
            if (productsToRender.length === 0) {
                marketplaceGrid.innerHTML = '<p class="col-span-full text-center text-gray-500 dark:text-gray-400">No products found matching your criteria.</p>';
                return;
            }
            productsToRender.forEach(product => {
                const card = document.createElement('div');
                card.className = 'card';
                card.innerHTML = `
                    <img src="${product.imageUrl}" alt="${product.name}" class="marketplace-card-image">
                    <div class="p-4">
                        <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-1">${product.name}No response
